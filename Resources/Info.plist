<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>Halo</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>dev.kennyb.Halo</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Halo</string>
    <key>CFBundleDisplayName</key>
    <string>Halo</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.2.0</string>
    <key>CFBundleVersion</key>
    <string>11</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 Kenny Baustert. Licensed under the GPL v3.</string>
    <!-- Pages rather than raw.githubusercontent.com: it's a CDN with the right content type, and
         this URL is baked into every shipped copy. build.sh strips it from local builds. -->
    <key>SUFeedURL</key>
    <string>https://kdbaustert.github.io/Halo/appcast.xml</string>
    <!-- Public half of Halo's own EdDSA key. Sparkle checks every download against it, so nobody
         else can ship Halo's users an update. The private half is in the login keychain under the
         account "Halo", where release.sh's generate_appcast reads it, and in the release
         workflow's SPARKLE_PRIVATE_KEY secret. -->
    <key>SUPublicEDKey</key>
    <string>PezeknkM2k7AVhKhpZWsosOLwkvB0C1ocBx+cHCCr/4=</string>
    <!-- Checks daily, but asks before installing: an update relaunches Halo and drops the boost
         for a moment. Both can be changed in Settings > About. -->
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUAutomaticallyUpdate</key>
    <false/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
</dict>
</plist>
